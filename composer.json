{
  "name": "vizuh/apointoo-wp-capture",
  "description": "Connect existing WordPress forms to the Apointoo capture contract. A capture/wiring adapter — not a form builder.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.9",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "Apointoo\\Capture\\": "includes/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "phpcs": "phpcs --standard=phpcs.xml.dist",
    "phpcbf": "phpcbf --standard=phpcs.xml.dist",
    "phpcompat": "phpcs -p --standard=PHPCompatibilityWP --runtime-set testVersion 8.0- --extensions=php --ignore=*/vendor/* apointoo-wp-capture.php uninstall.php includes/",
    "test": "phpunit"
  }
}
